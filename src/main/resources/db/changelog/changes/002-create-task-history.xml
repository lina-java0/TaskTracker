<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-task-history" author="lina">

        <createTable tableName="task_history">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(600)">
                <constraints nullable="false"/>
            </column>

            <column name="old_value" type="VARCHAR(600)"/>

            <column name="new_value" type="VARCHAR(600)"/>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex
                indexName="idx_task_history_task_id"
                tableName="task_history">

            <column name="task_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>